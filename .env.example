# Copiar a .env.local. Nunca commitear valores reales.
# Solo las variables con prefijo VITE_ llegan al bundle: NO poner secretos aquí.

# Base URL del API REST. En producción debe ser https.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Cifrado de campos sensibles (JWE RSA-OAEP-256 + A256GCM): required | off
VITE_PAYLOAD_ENCRYPTION=off
# Clave pública SPKI en PEM, en una línea con \n escapados. La privada vive solo en el backend.
VITE_PAYLOAD_PUBLIC_KEY=
VITE_PAYLOAD_KEY_ID=

# Timeout por petición en ms
VITE_HTTP_TIMEOUT_MS=15000

# SOLO desarrollo local sin backend: adaptadores en memoria (OTP válido: 1234). Prohibido en builds.
VITE_USE_MOCKS=false

# secret_key de empresa que exige POST /auth/login (campo "ref"). Ver README: en el bundle NO es secreto.
VITE_COMPANY_REF=
# SOLO desarrollo: destino del proxy de Vite para /api (evita CORS). Con esto, VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=
